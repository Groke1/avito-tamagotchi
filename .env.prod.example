IMAGE_TAG=latest

JWT_SECRET=replace_with_long_random_secret

HTTP_PORT=8080
SESSION_STORE=redis

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_USER=db_user
POSTGRES_PASSWORD=replace_with_user_db_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

PETS_HTTP_ADDR=pets:8080
TASKS_HTTP_ADDR=tasks:8080

USER_POSTGRES_DB=db
USER_POSTGRES_USER=db_user
USER_POSTGRES_PASSWORD=replace_with_user_db_password

TASKS_POSTGRES_DB=tasks
TASKS_POSTGRES_USER=tasks_user
TASKS_POSTGRES_PASSWORD=replace_with_tasks_db_password
DATABASE_DSN=postgres://tasks_user:replace_with_tasks_db_password@tasks-postgres:5432/tasks?sslmode=disable
HTTP_ADDR=:8080

PETS_POSTGRES_DB=pet_db
PETS_POSTGRES_USER=user
PETS_POSTGRES_PASSWORD=replace_with_pets_db_password
DATABASE_URL=postgres://user:replace_with_pets_db_password@pets-postgres:5432/pet_db?sslmode=disable
USER_SERVICE_URL=http://users:8080
